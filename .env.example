# Leave unset to use local SQLite at data/business-os.db (zero-config default).
DATABASE_URL=

# Admin desk password. When unset, the password is: demo
ADMIN_PASSWORD=

# Bot API key. Send it as the x-bot-api-key header (BOT_TOKEN is accepted as an alias).
# When unset, the key is: dev-bot-key
BOT_API_KEY=

# Optional. When unset, checkout uses the built-in demo page (no real money).
# If set, the key must start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public origin for return URLs. Optional; the request host is used when unset.
APP_URL=http://127.0.0.1:3000

# Optional override for the SQLite file used when DATABASE_URL is unset.
# SQLITE_PATH=data/business-os.db
